menu "RoadWeave HaLow link test"
choice RW_LINK_ROLE
    prompt "Device role"
    default RW_LINK_AP
config RW_LINK_AP
    bool "AP / UDP echo server"
config RW_LINK_STA
    bool "STA / UDP probe client"
endchoice
config RW_LINK_RF_ENABLE
    bool "Run radio connection test (requires prepared RF test setup)"
    default n
    help
        Disabled: inspect SPI and embedded FW/BCF files only; never boot radio firmware.
        Enabled: starts AP beacons or STA association and transmits UDP packets.
        WM6180 RF port must have a suitable load and the test setup must permit RF operation.
config RW_LINK_SSID
    string "Test SSID"
    default "RoadWeaveBench"
config RW_LINK_PSK
    string "Test WPA3 passphrase (keep local)"
    default ""
config RW_LINK_CHANNEL
    int "AP S1G channel (0 means not configured)"
    range 0 255
    default 0
config RW_LINK_OPCLASS
    int "AP operating class (0 means not configured)"
    range 0 255
    default 0
config RW_LINK_TX_POWER_DBM
    int "Maximum transmit power override (dBm; 0 disables override in SDK)"
    range 1 13
    default 1
config RW_LINK_CONTINUOUS
    bool "Finite continuous UDP validation (legacy 20 probes when disabled)"
    default n
    depends on RW_LINK_RF_ENABLE
config RW_LINK_THROUGHPUT
    bool "Serial-controlled finite one-way UDP throughput stages"
    default n
    depends on RW_LINK_CONTINUOUS
    help
        Opt-in replacement for the continuous echo workload. AP and STA can
        each receive or send bounded, independently commanded UDP stages.
config RW_TPUT_SESSION_SECONDS
    int "Maximum throughput command-session duration in seconds"
    range 60 3600
    default 1800
    depends on RW_LINK_THROUGHPUT
config RW_LINK_DHCP
    bool "Use AP DHCP server and STA DHCP client in continuous mode"
    default n
    depends on RW_LINK_CONTINUOUS
config RW_LINK_RUN_SECONDS
    int "Continuous run duration in seconds"
    range 30 28800
    default 180
    depends on RW_LINK_CONTINUOUS
config RW_LINK_MAX_PROBES
    int "STA maximum probes (0 uses duration only)"
    range 0 100000
    default 0
    depends on RW_LINK_CONTINUOUS && RW_LINK_STA
config RW_LINK_PAYLOAD_BYTES
    int "Continuous UDP datagram length in bytes"
    range 32 1024
    default 256
    depends on RW_LINK_CONTINUOUS
config RW_LINK_INTERVAL_MS
    int "Continuous STA probe interval in milliseconds"
    range 100 5000
    default 250
    depends on RW_LINK_CONTINUOUS && RW_LINK_STA
config RW_LINK_STA_ID
    int "STA ID (1 => 192.168.50.2, 2 => 192.168.50.3)"
    range 1 2
    default 1
    depends on RW_LINK_STA
endmenu
